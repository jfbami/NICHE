# Box (JWT Server Authentication — download config from Box Developer Console)
BOX_CONFIG_PATH=../your_box_config.json
# Hosted alternative (App Runner / Render / Fly): set BOX_CONFIG_JSON_BASE64
# instead and leave BOX_CONFIG_PATH empty. Value is your box_config.json
# base64-encoded into a single line.
BOX_CONFIG_JSON_BASE64=
NEESH_ROOT_FOLDER_ID=

# App
NEESH_JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# Apify (Reddit + Instagram scrapers for /api/seed/*)
APIFY_API_TOKEN=

# Mapbox (geocoding for seed sources → coordinates)
MAPBOX_TOKEN=

# AWS Bedrock (Claude Haiku 4.5 for Instagram caption → spot extraction)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
